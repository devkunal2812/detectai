# ═══════════════════════════════════════════
#   DetectAI — Environment Variables
# ═══════════════════════════════════════════

# ── Backend ──────────────────────────────────
PORT=8000
ENV=development

# Database (PostgreSQL / Supabase)
# Get from: https://supabase.com or your PostgreSQL provider
DATABASE_URL=postgresql://user:password@host:5432/detectai

# CORS — comma-separated frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.vercel.app

# ── Frontend (Vite) ──────────────────────────
# Backend API URL
VITE_API_URL=http://localhost:8000

# ── Optional: Hugging Face ───────────────────
# If using gated models, add your HF token
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
